# Copy to .env (local) or export in your host. Compose reads this file automatically.
NODE_ENV=development
PORT=4000
DB_PATH=./data/prm.sqlite
JWT_SECRET=change-me-to-a-long-random-string

# Database: leave blank for a plain local SQLite file. Set both to sync with
# Turso (embedded replica: local file + background sync, survives disk wipes).
TURSO_URL=
TURSO_TOKEN=

# Email: Brevo HTTP API is the reliable path on free hosts (SMTP ports are
# often blocked there). Verify a sender in Brevo, create an API key, set both.
BREVO_API_KEY=
BREVO_SENDER=

# Email via SMTP (VPS or hosts with SMTP egress). Ignored when BREVO_API_KEY
# is set. Leave all blank for console-log demo mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Rent Ledger <no-reply@example.com>

# SMS: easiest is Brevo transactional SMS on the same account and key as mail.
# Set BREVO_SMS_SENDER to an approved sender name (credits required, see the
# Brevo dashboard). Falls back to a generic gateway below when unset.
BREVO_SMS_SENDER=

# WhatsApp Cloud API (Meta): the free path for OTPs and reminders. Create an
# app at developers.facebook.com, add a WhatsApp number, approve one UTILITY
# template whose body is exactly: Rent Ledger update: {{1}}
# Then set the permanent token, phone number id, and template name.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=rent_update

# SMS fallback: any gateway that accepts POST {to, message} with 2xx.
# Leave blank to keep SMS stubbed.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_KEY=
